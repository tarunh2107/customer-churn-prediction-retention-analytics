.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints & runtime cache
.ipynb_checkpoints
*/.ipynb_checkpoints/*

